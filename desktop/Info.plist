<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist when it is bundled. agdash supports macOS 14 and
     later; this is the check macOS makes before it opens the app. The compiler's
     deployment target stays at 11.0 (bundle.macos.json): with 14.0, Rust 1.95 cannot
     load the procedural macros it has just built. -->
<plist version="1.0">
<dict>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
</dict>
</plist>
