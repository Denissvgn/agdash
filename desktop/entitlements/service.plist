<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The frozen service unpacks its Python libraries into a temporary folder and loads
     them from there. They are signed with the same identity when it is frozen; this
     lets them load if the runtime's library check sees them as from elsewhere. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
